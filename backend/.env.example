# Copy to .env and adjust. Used by Docker Compose and local runs.
DATABASE_URL=postgresql+asyncpg://mess:mess@localhost:5432/mess_todo
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
API_WORKERS=1
REDIS_URL=redis://localhost:6379/0
NOTIFICATION_SYNC_MINUTES=10
# Ротация уведомлений: прочитанные / непрочитанные / напоминания по заметкам (дни).
NOTIFICATION_RETENTION_READ_DAYS=90
NOTIFICATION_RETENTION_UNREAD_DAYS=180
NOTIFICATION_RETENTION_NOTE_REMINDER_DAYS=30
WORKER_MAX_JOBS=2
BACKUP_DIR=/backups
BACKUP_KEEP=40
BACKUP_AUTO_ENABLED=true
BACKUP_RETENTION_DAYS=10
BACKUP_HOUR=3
BACKUP_MINUTE=0
BACKUP_TZ=Asia/Krasnoyarsk
# На старте API выполняется alembic upgrade head (удобно для пустой БД). Отключите, если миграции гоняете отдельно.
AUTO_MIGRATE_ON_STARTUP=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
USPD_SECRETS_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Локальный uvicorn без nginx: заголовки не доверяем, в аудите TCP-пир.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Auto-created first admin when DB has no users
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=admin123456
INITIAL_ADMIN_FULL_NAME=Администратор
STORAGE_BACKEND=minio # Если локально то - local, minio - файлы будут в minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mess-workspace
MINIO_PUBLIC_BASE_URL=/mes/files
# Сироты в MinIO/uploads. false — воркер только пишет в лог, ничего не удаляет.
STORAGE_GC_ENABLED=false
STORAGE_GC_MIN_AGE_DAYS=14
