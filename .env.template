# Скопируйте в .env в корне репозитория:  cp .env.template .env
# Используется docker compose (сервисы api, web, api-job).

# --- PostgreSQL (внешний, вне Docker) ---
# Важно: из контейнера api нельзя использовать localhost — укажите IP/LAN-хост сервера БД
# или host.docker.internal (Linux: в compose уже добавлен extra_hosts).
# Пример: postgresql+asyncpg://mess:secret@192.168.1.10:5432/mess_todo
# Пример: postgresql+asyncpg://mess:secret@host.docker.internal:5432/mess_todo
DATABASE_URL=postgresql+asyncpg://user:password@host.docker.internal:5432/mess_todo

SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTO_MIGRATE_ON_STARTUP=true
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Первый суперпользователь (создаётся при пустой БД)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-on-first-deploy
INITIAL_ADMIN_FULL_NAME=Системный администратор

# --- Файлы (MinIO внутри compose) ---
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mess-workspace
# URL, по которому браузер/клиенты открывают файлы (IP или домен сервера)
MINIO_PUBLIC_BASE_URL=http://your-server-ip:9000

# --- Порты на хосте ---
WEB_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Для docker compose оставьте пустым (nginx проксирует /api на api:8000)
VITE_API_BASE=
